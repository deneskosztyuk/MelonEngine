import {
    Theme,
    MenuButton,
    ToolButton,
    GhostButton,
    PanelHeader,
    SectionLabel,
    SearchBox,
    Splitter,
    EditorTab,
    ConsoleContent,
    PlaceholderContent,
} from "theme.slint";

export struct SceneEntityRow {
    id: int,
    name: string,
}

export component EditorWindow inherits Window {
    title: "MelonEngine Editor";
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 300px;
    background: Theme.chrome;

    in-out property <image> scene-texture;
    in property <[SceneEntityRow]> scene-entities;
    in-out property <int> selected-entity-id: -1;
    in property <string> selected-name: "Nothing selected";
    in property <string> selected-position: "-";
    in property <string> selected-rotation: "-";
    in property <string> selected-scale: "-";

    // ---- Toolbar / transport state (visual only for now) ----
    in-out property <string> gizmo-mode: "Move";
    in-out property <bool> playing: false;

    // ---- Pane sizing (px, persisted via Rust) ----
    in-out property <length> left-pane-width: Theme.left-pane-default;
    in-out property <length> right-pane-width: Theme.right-pane-default;
    in-out property <length> bottom-pane-height: Theme.bottom-pane-default;

    // Available width after reserving the guaranteed viewport + splitter gutters.
    // Used only in splitter `moved` handlers (imperative, runs on drag) — never
    // in element size bindings, to avoid layoutinfo binding loops.
    private property <length> side-pane-available:
        max(0px, root.width - Theme.scene-min-width - Theme.splitter-size * 2);
    // Available height after reserving the fixed chrome (menu, toolbar, status,
    // one splitter) and the guaranteed minimum for the whole center region.
    // Used only in the bottom splitter `moved` handler.
    private property <length> bottom-pane-available:
        max(0px, root.height - Theme.menu-height - Theme.toolbar-height - Theme.status-height
            - Theme.splitter-size - Theme.panel-header-height - Theme.scene-min-height);

    // Pane sizes are stored as the user's desired value (clamped on drag by the
    // splitter handlers) and bound directly to element widths/heights. The scene
    // viewport has `horizontal-stretch: 1` / `vertical-stretch: 1` so it absorbs
    // any slack; its `min-width`/`min-height` protect it from collapsing. We do
    // NOT derive clamped sizes from root.width/height in bindings — that creates
    // a binding loop through layoutinfo-h/layoutinfo-v.

    // ---- Dock model (owned by Rust, persisted via console-in-right) ----
    in-out property <bool> console-in-right: false;
    in property <[string]> bottom-tabs: root.console-in-right
        ? ["Content Browser"]
        : ["Content Browser", "Console"];
    in property <[string]> right-tabs: root.console-in-right
        ? ["Inspector", "Console"]
        : ["Inspector"];
    in-out property <string> right-active-tab: "Inspector";
    in-out property <string> bottom-active-tab: "Content Browser";

    // ---- Drag state ----
    in-out property <bool> drag-active: false;
    in-out property <bool> drop-target-bottom: bottom-drop.has-hover && root.drag-active;
    in-out property <bool> drop-target-right: right-drop.has-hover && root.drag-active;

    out property <length> viewport-width: scene-image.width;
    out property <length> viewport-height: scene-image.height;
    out property <bool> viewport-hovered: viewport-input.has-hover;

    // Group geometry for drop hit-testing from Rust.
    out property <length> bottom-group-x: bottom-group.x;
    out property <length> bottom-group-y: bottom-group.y;
    out property <length> bottom-group-width: bottom-group.width;
    out property <length> bottom-group-height: bottom-group.height;
    out property <length> right-group-x: right-group.x;
    out property <length> right-group-y: right-group.y;
    out property <length> right-group-width: right-group.width;
    out property <length> right-group-height: right-group.height;

    callback select-entity(int);
    callback tab-pressed(string);
    callback tab-released(string);
    callback layout-changed;
    callback request-frame;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: Theme.menu-height;
            background: Theme.chrome;
            border-color: Theme.border;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 0px;
                MenuButton { text: "File"; }
                MenuButton { text: "Edit"; }
                MenuButton { text: "GameObject"; }
                MenuButton { text: "Window"; }
                MenuButton { text: "Help"; }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text {
                    text: "MELON ENGINE  0.1";
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: Theme.toolbar-height;
            background: Theme.chrome-raised;
            border-color: Theme.border;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 5px;
                padding-bottom: 5px;
                spacing: 4px;

                // Gizmo modes
                ToolButton { text: "Select"; label: "Select"; active: root.gizmo-mode == "Select"; }
                ToolButton { text: "Move"; label: "Move"; active: root.gizmo-mode == "Move"; }
                ToolButton { text: "Rotate"; label: "Rotate"; active: root.gizmo-mode == "Rotate"; }
                ToolButton { text: "Scale"; label: "Scale"; active: root.gizmo-mode == "Scale"; }
                Rectangle { width: 1px; background: Theme.border-strong; }

                ToolButton { text: "Undo"; label: "Undo"; enabled: false; }
                ToolButton { text: "Redo"; label: "Redo"; enabled: false; }
                Rectangle { horizontal-stretch: 1; background: transparent; }

                Rectangle { width: 1px; background: Theme.border-strong; }
                ToolButton { text: "▶"; label: "Play"; active: root.playing; }
                ToolButton { text: "⏸"; label: "Pause"; }
                ToolButton { text: "Step"; label: "Step"; }
                Rectangle { horizontal-stretch: 1; background: transparent; }

                Text {
                    text: "Perspective   Lit";
                    color: Theme.text-muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            spacing: 0px;
            vertical-stretch: 1;
            min-height: 0px;

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;
                min-height: 0px;

                Rectangle {
                    width: root.left-pane-width;
                    min-height: 0px;
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;

                    VerticalLayout {
                        spacing: 0px;
                        min-height: 0px;
                        PanelHeader { title: "Hierarchy"; }

                        Rectangle {
                            height: Theme.input-height + 10px;
                            background: Theme.surface;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 6px;
                                SearchBox { placeholder: "Search"; horizontal-stretch: 1; }
                                GhostButton { text: "+ Add"; }
                            }
                        }

                        SectionLabel { label: "SCENE"; }

                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 0px;
                            background: Theme.surface;
                            Flickable {
                                vertical-stretch: 1;
                                min-height: 0px;
                                viewport-height: list-layout.preferred-height;
                                list-layout := VerticalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    padding-bottom: 6px;
                                    spacing: 2px;
                                    for entity in root.scene-entities: Rectangle {
                                        height: Theme.row-height;
                                        background: entity.id == root.selected-entity-id
                                            ? Theme.accent-soft
                                            : entity-hover.has-hover ? Theme.surface-raised : transparent;
                                        border-radius: 2px;

                                        Rectangle {
                                            x: 7px;
                                            y: 6px;
                                            width: 14px;
                                            height: 14px;
                                            border-color: entity.id == root.selected-entity-id ? Theme.accent : Theme.text-muted;
                                            border-width: 1px;
                                            border-radius: 2px;
                                            background: transparent;
                                        }
                                        Text {
                                            x: 30px;
                                            vertical-alignment: center;
                                            text: entity.name;
                                            color: Theme.text;
                                            font-size: 12px;
                                        }
                                        entity-hover := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.selected-entity-id = entity.id;
                                                root.select-entity(entity.id);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Splitter {
                    width: Theme.splitter-size;
                    vertical: true;
                    moved(delta) => {
                        root.left-pane-width = max(Theme.left-pane-min,
                            min(Theme.left-pane-max,
                                min(root.side-pane-available - root.right-pane-width,
                                    root.left-pane-width + delta * 1px)));
                    }
                    drag-finished => { root.layout-changed(); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    min-width: Theme.scene-min-width;
                    min-height: Theme.panel-header-height + Theme.scene-min-height;
                    background: Theme.viewport;
                    border-color: Theme.border;
                    border-width: 1px;

                    VerticalLayout {
                        spacing: 0px;
                        min-height: 0px;
                        PanelHeader { title: "Scene"; }
                        Rectangle {
                            vertical-stretch: 1;
                            min-height: Theme.scene-min-height;
                            background: Theme.viewport;

                            scene-image := Image {
                                width: 100%;
                                height: 100%;
                                source: root.scene-texture;
                                image-fit: contain;
                            }
                            viewport-input := TouchArea {
                                mouse-cursor: crosshair;
                            }

                            // Viewport overlay toolbar (visual only).
                            Rectangle {
                                x: 10px;
                                y: 10px;
                                height: 28px;
                                width: viewport-mode-label.preferred-width + viewport-gizmo-label.preferred-width + 28px;
                                background: Theme.chrome;
                                border-color: Theme.border;
                                border-width: 1px;
                                border-radius: Theme.control-radius;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 10px;
                                    viewport-gizmo-label := Text {
                                        text: root.gizmo-mode;
                                        color: Theme.text;
                                        font-size: 11px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    viewport-mode-label := Text {
                                        text: "Lit";
                                        color: Theme.text-muted;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                Splitter {
                    width: Theme.splitter-size;
                    vertical: true;
                    moved(delta) => {
                        root.right-pane-width = max(Theme.right-pane-min,
                            min(Theme.right-pane-max,
                                min(root.side-pane-available - root.left-pane-width,
                                    root.right-pane-width - delta * 1px)));
                    }
                    drag-finished => { root.layout-changed(); }
                }

                // Right dock group (Inspector / Console)
                right-group := Rectangle {
                    width: root.right-pane-width;
                    min-height: 0px;
                    background: Theme.surface;
                    border-color: root.drop-target-right ? Theme.accent : Theme.border;
                    border-width: 1px;

                    right-drop := TouchArea {
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: 100%;
                        enabled: root.drag-active;
                    }

                    VerticalLayout {
                        spacing: 0px;
                        min-height: 0px;
                        HorizontalLayout {
                            height: Theme.panel-header-height;
                            spacing: 0px;
                            for tab in root.right-tabs: EditorTab {
                                text: tab;
                                active: tab == root.right-active-tab;
                                pressed => { root.tab-pressed(tab); }
                                released => { root.tab-released(tab); }
                            }
                            Rectangle { horizontal-stretch: 1; background: Theme.chrome-raised; }
                        }

                        if root.right-active-tab == "Console": ConsoleContent {}
                        if root.right-active-tab == "Inspector": Rectangle {
                            vertical-stretch: 1;
                            min-height: 0px;
                            background: Theme.surface;
                            Flickable {
                                vertical-stretch: 1;
                                min-height: 0px;
                                viewport-height: inspector-body.preferred-height;
                                inspector-body := VerticalLayout {
                                    spacing: 0px;
                                    min-height: 0px;
                                    Rectangle {
                                        height: 48px;
                                        background: Theme.surface-raised;
                                        Text {
                                            x: 12px;
                                            vertical-alignment: center;
                                            text: root.selected-name;
                                            color: Theme.text;
                                            font-size: 14px;
                                            font-weight: 600;
                                        }
                                    }
                                    Rectangle {
                                        height: 32px;
                                        background: Theme.chrome-raised;
                                        border-color: Theme.border;
                                        border-width: 1px;
                                        Text {
                                            x: 12px;
                                            vertical-alignment: center;
                                            text: "TRANSFORM";
                                            color: Theme.text-muted;
                                            font-size: 10px;
                                            font-weight: 700;
                                        }
                                    }
                                    GridLayout {
                                        padding: 12px;
                                        spacing: 9px;
                                        Row {
                                            Text { text: "Position"; color: Theme.text-muted; font-size: 11px; }
                                            Text { text: root.selected-position; color: Theme.text; font-size: 11px; }
                                        }
                                        Row {
                                            Text { text: "Rotation"; color: Theme.text-muted; font-size: 11px; }
                                            Text { text: root.selected-rotation; color: Theme.text; font-size: 11px; }
                                        }
                                        Row {
                                            Text { text: "Scale"; color: Theme.text-muted; font-size: 11px; }
                                            Text { text: root.selected-scale; color: Theme.text; font-size: 11px; }
                                        }
                                    }
                                    Rectangle {
                                        height: 32px;
                                        background: Theme.chrome-raised;
                                        border-color: Theme.border;
                                        border-width: 1px;
                                        Text {
                                            x: 12px;
                                            vertical-alignment: center;
                                            text: "COMPONENTS";
                                            color: Theme.text-muted;
                                            font-size: 10px;
                                            font-weight: 700;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding: 10px;
                                        GhostButton { text: "+ Add Component"; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Splitter {
                height: Theme.splitter-size;
                vertical: false;
                moved(delta) => {
                    root.bottom-pane-height = max(Theme.bottom-pane-min,
                        min(root.bottom-pane-available * Theme.bottom-pane-max-ratio,
                            root.bottom-pane-height - delta * 1px));
                }
                drag-finished => { root.layout-changed(); }
            }

            // Bottom dock group (Content Browser / Console)
            bottom-group := Rectangle {
                height: root.bottom-pane-height;
                min-width: 0px;
                background: Theme.surface;
                border-color: root.drop-target-bottom ? Theme.accent : Theme.border;
                border-width: 1px;

                bottom-drop := TouchArea {
                    x: 0px;
                    y: 0px;
                    width: 100%;
                    height: 100%;
                    enabled: root.drag-active;
                }

                VerticalLayout {
                    spacing: 0px;
                    min-height: 0px;
                    HorizontalLayout {
                        height: Theme.panel-header-height;
                        spacing: 0px;
                        for tab in root.bottom-tabs: EditorTab {
                            text: tab;
                            active: tab == root.bottom-active-tab;
                            pressed => { root.tab-pressed(tab); }
                            released => { root.tab-released(tab); }
                        }
                        Rectangle { horizontal-stretch: 1; background: Theme.chrome-raised; }
                    }

                    if root.bottom-active-tab == "Console": ConsoleContent {}
                    if root.bottom-active-tab == "Content Browser": PlaceholderContent {
                        title: "Content Browser";
                        subtitle: "assets/models     assets/shaders";
                    }
                }
            }
        }

        Rectangle {
            height: Theme.status-height;
            background: Theme.chrome;
            border-color: Theme.border;
            border-width: 1px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 14px;
                Text {
                    text: "Ready";
                    color: Theme.success;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: "v0.1";
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text {
                    text: "60 FPS";
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: "1 entity";
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: root.gizmo-mode;
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }
        }
    }
}
