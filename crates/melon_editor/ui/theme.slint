export global Theme {
    out property <color> chrome: #111316;
    out property <color> chrome-raised: #181b20;
    out property <color> surface: #1c2026;
    out property <color> surface-raised: #242932;
    out property <color> viewport: #343b46;
    out property <color> border: #303640;
    out property <color> border-strong: #414956;
    out property <color> text: #e1e5eb;
    out property <color> text-muted: #89919d;
    out property <color> accent: #2f79cf;
    out property <color> accent-hover: #3e8be2;
    out property <color> accent-soft: #23476f;
    out property <color> success: #51b37f;
    out property <color> warning: #d9a441;
    out property <color> error: #e05656;
    out property <color> info: #6cb2e6;
    out property <length> menu-height: 28px;
    out property <length> toolbar-height: 38px;
    out property <length> panel-header-height: 30px;
    out property <length> status-height: 23px;
    out property <length> splitter-size: 4px;
    out property <length> compact-spacing: 6px;
    out property <length> control-radius: 3px;
    out property <length> input-height: 24px;
    out property <length> row-height: 26px;
    out property <length> section-gap: 10px;
    out property <length> icon-size: 14px;
    out property <length> left-pane-default: 220px;
    out property <length> left-pane-min: 180px;
    out property <length> left-pane-max: 360px;
    out property <length> right-pane-default: 260px;
    out property <length> right-pane-min: 200px;
    out property <length> right-pane-max: 360px;
    out property <length> bottom-pane-default: 200px;
    out property <length> bottom-pane-min: 72px;
    // The bottom pane is bounded by a fraction of the window's available height
    // rather than an absolute px value, so dragging it large can never push the
    // window past its own bounds (which caused fullscreen loss + empty space).
    out property <float> bottom-pane-max-ratio: 0.55;
    out property <length> scene-min-width: 230px;
    out property <length> scene-min-height: 80px;
}

export component MenuLabel inherits Rectangle {
    in property <string> text;
    height: Theme.menu-height;
    width: label.preferred-width + 22px;
    background: hover.has-hover ? Theme.surface-raised : transparent;
    border-radius: 2px;

    label := Text {
        x: 10px;
        vertical-alignment: center;
        text: root.text;
        color: Theme.text;
        font-size: 12px;
        font-weight: 500;
    }

    hover := TouchArea {}
}

export component ToolButton inherits Rectangle {
    in property <string> text;
    in property <string> label: "";
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked;
    height: 28px;
    width: root.label == "" ? 30px : btn-label.preferred-width + 20px;
    background: !root.enabled ? transparent
        : root.active ? Theme.accent-soft
        : hover.has-hover ? Theme.surface-raised
        : transparent;
    border-color: root.active ? Theme.accent : transparent;
    border-width: 1px;
    border-radius: Theme.control-radius;

    btn-label := Text {
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.label == "" ? root.text : root.label;
        color: !root.enabled ? Theme.border-strong
            : root.active ? #f4f8ff
            : hover.has-hover ? Theme.text
            : Theme.text-muted;
        font-size: 12px;
        font-weight: 600;
    }

    hover := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component MenuButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;
    height: Theme.menu-height;
    width: label.preferred-width + 22px;
    background: root.enabled && hover.has-hover ? Theme.surface-raised : transparent;
    border-radius: 2px;

    label := Text {
        x: 10px;
        vertical-alignment: center;
        text: root.text;
        color: root.enabled ? Theme.text : Theme.border-strong;
        font-size: 12px;
        font-weight: 500;
    }

    hover := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component GhostButton inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 24px;
    width: label.preferred-width + 22px;
    background: hover.has-hover ? Theme.accent-soft : transparent;
    border-color: hover.has-hover ? Theme.accent : Theme.border;
    border-width: 1px;
    border-radius: Theme.control-radius;

    label := Text {
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        color: hover.has-hover ? #f4f8ff : Theme.text;
        font-size: 11px;
        font-weight: 600;
    }

    hover := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component PanelHeader inherits Rectangle {
    in property <string> title;
    in property <bool> active: true;
    height: Theme.panel-header-height;
    background: Theme.chrome-raised;
    border-width: 0px;

    Rectangle {
        x: 0px;
        y: 0px;
        width: 3px;
        height: parent.height;
        background: root.active ? Theme.accent : transparent;
    }

    Text {
        x: 12px;
        vertical-alignment: center;
        text: root.title;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: 12px;
        font-weight: 600;
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border;
    }
}

export component SectionLabel inherits Text {
    in property <string> label;
    height: 18px;
    vertical-alignment: center;
    text: root.label;
    color: Theme.text-muted;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

export component Splitter inherits Rectangle {
    callback moved(float);
    callback drag-finished;
    in property <bool> vertical: true;
    in-out property <length> last-pointer-position: 0px;
    background: drag.has-hover || drag.pressed ? Theme.accent : Theme.border;

    drag := TouchArea {
        x: root.vertical ? -2px : 0px;
        y: root.vertical ? 0px : -2px;
        width: root.vertical ? root.width + 4px : root.width;
        height: root.vertical ? root.height : root.height + 4px;
        mouse-cursor: root.vertical ? MouseCursor.col-resize : MouseCursor.row-resize;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.last-pointer-position = root.vertical
                    ? self.absolute-position.x + self.mouse-x
                    : self.absolute-position.y + self.mouse-y;
            }
            if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                root.drag-finished();
            }
        }
        moved => {
            if self.pressed {
                root.moved(root.vertical
                    ? (self.absolute-position.x + self.mouse-x - root.last-pointer-position) / 1px
                    : (self.absolute-position.y + self.mouse-y - root.last-pointer-position) / 1px);
                root.last-pointer-position = root.vertical
                    ? self.absolute-position.x + self.mouse-x
                    : self.absolute-position.y + self.mouse-y;
            }
        }
    }
}

export component EditorTab inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback pressed;
    callback released;
    height: Theme.panel-header-height;
    width: label.preferred-width + 30px;
    background: root.active ? Theme.surface-raised : transparent;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: 0px;

    label := Text {
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        color: root.active ? Theme.text : Theme.text-muted;
        font-size: 11px;
        font-weight: 600;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { root.pressed(); }
            if event.kind == PointerEventKind.up { root.released(); }
        }
    }
}

export component SearchBox inherits Rectangle {
    in property <string> placeholder;
    height: Theme.input-height;
    background: Theme.surface-raised;
    border-color: border-hover.has-hover ? Theme.accent : Theme.border;
    border-width: 1px;
    border-radius: Theme.control-radius;

    Text {
        x: 8px;
        y: 4px;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: 11px;
    }

    border-hover := TouchArea { mouse-cursor: text; }
}

export component ConsoleContent inherits Rectangle {
    background: Theme.surface;
    vertical-stretch: 1;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 26px;
            background: Theme.chrome-raised;
            border-color: Theme.border;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                Text {
                    text: "INFO";
                    color: Theme.info;
                    font-size: 10px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: "WARN";
                    color: Theme.warning;
                    font-size: 10px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: "ERROR";
                    color: Theme.error;
                    font-size: 10px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Text {
                    text: "CLEAR";
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            padding: 10px;
            spacing: 6px;

            Text {
                text: "[Info] Simulation: Playing";
                color: Theme.info;
                font-size: 11px;
            }
            Text {
                text: "[Info] Entities: 2";
                color: Theme.info;
                font-size: 11px;
            }
            Text {
                text: "[Info] Renderer: Skia / WGPU 29";
                color: Theme.info;
                font-size: 11px;
            }
            Text {
                text: "[Warn] No skybox assigned";
                color: Theme.warning;
                font-size: 11px;
            }
        }
    }
}

export component PlaceholderContent inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";
    background: Theme.surface;
    vertical-stretch: 1;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 26px;
            background: Theme.chrome-raised;
            border-color: Theme.border;
            border-width: 1px;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    vertical-alignment: center;
                    text: root.subtitle == "" ? "Assets" : root.subtitle;
                    color: Theme.text-muted;
                    font-size: 11px;
                }
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            padding: 10px;
            spacing: 8px;
            Text {
                text: root.title;
                color: Theme.text-muted;
                font-size: 10px;
                font-weight: 700;
            }
            // Folder tiles
            Rectangle {
                height: 52px;
                background: models-tile-hover.has-hover ? Theme.surface-raised : Theme.chrome-raised;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: Theme.control-radius;

                Text {
                    x: 10px;
                    vertical-alignment: center;
                    text: "📁  assets/models";
                    color: Theme.text;
                    font-size: 12px;
                }

                models-tile-hover := TouchArea { mouse-cursor: pointer; }
            }
            Rectangle {
                height: 52px;
                background: shaders-tile-hover.has-hover ? Theme.surface-raised : Theme.chrome-raised;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: Theme.control-radius;

                Text {
                    x: 10px;
                    vertical-alignment: center;
                    text: "📁  assets/shaders";
                    color: Theme.text;
                    font-size: 12px;
                }

                shaders-tile-hover := TouchArea { mouse-cursor: pointer; }
            }
        }
    }
}
